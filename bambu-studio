#!/usr/bin/env python3
"""Launch the project-local Bambu Studio with its required runtime environment."""

from __future__ import annotations

import os
import sys
from pathlib import Path

from tools.bambu_studio import absolute_existing_paths, command, gui_environment


ROOT = Path(__file__).resolve().parent


def main() -> None:
    invocation = command(*absolute_existing_paths(sys.argv[1:]))
    os.chdir(ROOT)
    os.execve(invocation[0], invocation, gui_environment())


if __name__ == "__main__":
    main()
